# REQUIRED
GEMINI_API_KEY=your_google_gemini_key

# STRONGLY RECOMMENDED FALLBACK
GROQ_API_KEY=your_groq_key

# OPTIONAL EXTRA JURY ROUTES
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Model overrides (defaults are already set in server.js)
GEMINI_FAST_MODEL=gemini-3.8-flash
GEMINI_PRO_MODEL=gemini-3.1-pro-preview
GROQ_COMPOUND_MODEL=groq/compound
GROQ_MODEL_120B=openai/gpt-oss-120b
GROQ_MODEL_QWEN=qwen/qwen3.8-27b
OPENAI_MODEL=gpt-5.6-sol
ANTHROPIC_MODEL=claude-opus-5
