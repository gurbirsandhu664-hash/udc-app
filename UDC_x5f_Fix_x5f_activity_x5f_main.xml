<?xml version="1.0" encoding="utf-8"?>
<!-- UDC FIX LAYOUT - 3 Answer System Hata ke Direct Answer Layout -->
<!-- Isnu activity_main.xml nal replace kar de -->

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="UDC AI - Direct Answer"
        android:textSize="22sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/questionInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:hint="UDC da Question ethe likh..."
        android:padding="12dp"
        android:background="@android:drawable/edit_text" />

    <Button
        android:id="@+id/askButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Sahi Answer Lao" />

    <!-- 3 OPTION WALA SYSTEM HATA DITTA - NO RadioGroup -->

    <TextView
        android:id="@+id/answerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="20dp"
        android:text="Answer ethe aayega..."
        android:textSize="16sp"
        android:padding="12dp"
        android:background="#F0F0F0" />

</LinearLayout>
