# PRIMARY FINAL AI — Google AI Studio / Gemini
# You can put one or more keys, comma-separated.
GEMINI_KEYS=your_gemini_key_1,your_gemini_key_2
# Also accepted: GEMINI_KEY or GOOGLE_AI_STUDIO_KEY

# Gemini model rotation. Current stable models are preferred.
# The server tries these in order and skips unavailable/quota-limited models.
GEMINI_MODELS=gemini-3.8-flash,gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite

# RESEARCH ONLY — NEVER displayed as final answer
GROQ_KEYS=your_groq_key
GROQ_MODEL=groq/compound

# Optional Google Programmable Search. NOT the Gemini AI Studio key.
# If omitted, Gemini Google Search grounding is still used by the final model.
GOOGLE_CSE_KEY=
GOOGLE_CSE_ID=

# Optional tuning
GEMINI_ATTEMPTS_PER_COMBINATION=1
REQUEST_TIMEOUT_MS=45000
