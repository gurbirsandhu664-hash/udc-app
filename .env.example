GEMINI_API_KEY=PASTE_YOUR_GOOGLE_AI_STUDIO_KEY_HERE
# Gemini is always the FINAL provider. Put preferred working models first.
GEMINI_MODELS=gemini-2.5-flash,gemini-2.5-pro,gemini-2.0-flash
# Optional research-only assistant. It is NEVER returned as the final answer.
GROQ_API_KEY=PASTE_YOUR_GROQ_KEY_HERE
GROQ_MODEL=openai/gpt-oss-120b
PORT=10000
# Optional: path to your legally obtained/licensed UDC dataset.
# MRF_PATH=data/udc-mrf.json
