# Required for Gemini primary
GEMINI_API_KEY=
# Optional: comma-separated extra Gemini keys; tried in order if one is rate-limited
GEMINI_API_KEYS=

# Required for Groq fallback
GROQ_API_KEY=
# Optional: comma-separated extra Groq keys
GROQ_API_KEYS=

# Optional model overrides
GEMINI_MODEL=gemini-2.5-flash
GROQ_MODEL=groq/compound

PORT=10000
