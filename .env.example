# Render environment variables — do not commit real secrets
GEMINI_API_KEY=
# Optional override; default is gemini-2.5-flash
# V12.6 enables Google Search grounding inside Gemini; the Gemini API key must have access to Search grounding.
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
GROQ_MODEL=
PORT=10000
