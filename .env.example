# NEVER put real API keys in GitHub.
# Render -> Environment Variables

# You can provide multiple keys separated by commas.
# The server rotates to the next key when a provider returns 429/quota.
GEMINI_API_KEYS=
GROQ_API_KEYS=

# Optional single-key names also supported:
GEMINI_API_KEY=
GROQ_API_KEY=

# Gemini model with Google Search grounding
GEMINI_MODEL=gemini-2.5-flash

# Groq fallback model. groq/compound can use built-in web search.
GROQ_MODEL=groq/compound

PORT=10000
