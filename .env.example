# Render Environment Variables
GEMINI_API_KEY=PASTE_YOUR_GOOGLE_AI_STUDIO_KEY
# Comma-separated fallback chain; do not use retired model IDs.
GEMINI_MODELS=gemini-3.8-flash,gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash,gemini-2.5-flash,gemini-2.5-pro

# Optional fallback when Gemini quota is exhausted.
GROQ_API_KEY=PASTE_YOUR_GROQ_KEY
GROQ_MODELS=groq/compound,llama-3.3-70b-versatile

PORT=10000
