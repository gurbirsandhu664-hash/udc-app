PORT=10000
GEMINI_API_KEY=PASTE_YOUR_GOOGLE_AI_STUDIO_KEY
# Optional: comma-separated Gemini models to try in order if one is unavailable/quota-limited.
GEMINI_MODELS=gemini-3.8-flash,gemini-3.6-flash
# Optional research-only Groq key. Groq is NEVER displayed as the final classifier.
GROQ_API_KEY=PASTE_YOUR_GROQ_KEY
GROQ_MODEL=groq/compound
