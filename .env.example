# Gemini is the only AI allowed to produce the final UDC classification.
GEMINI_API_KEY=
# Optional: comma-separated legitimate keys from separate configured projects.
# GEMINI_API_KEYS=
# Optional comma-separated Gemini model fallback order.
# GEMINI_MODELS=gemini-2.5-pro,gemini-2.5-flash,gemini-2.0-flash

# Optional research-only support. Groq is never shown as the final classifier.
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b

PORT=10000
